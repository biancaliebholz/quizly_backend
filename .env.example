# Quizly backend configuration
# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env - it contains secrets. Values below are placeholders.

# --- Django (required) -------------------------------------------------------
# Secret key for signing sessions and JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# (No "$" characters: Docker Compose would interpolate them.)
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Debug mode. Default if unset: False. Set True for local development
# (detailed error pages, admin CSS served by runserver). Never True in production.
DJANGO_DEBUG=True

# Hosts Django answers to (comma-separated). Default: 127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Frontend & cookies (optional) ------------------------------------------
# Origin(s) of the school frontend (comma-separated, exact scheme://host:port).
# Used for CORS and the CSRF origin check. Default: http://127.0.0.1:5500
FRONTEND_ORIGINS=http://127.0.0.1:5500

# Send cookies only via HTTPS. Default: False (local http). True in production.
AUTH_COOKIE_SECURE=False

# --- Gemini (required for quiz generation) ----------------------------------
# API key from Google AI Studio. Keep it secret.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Gemini model id. Default: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Timeout for one Gemini request in seconds. Default: 120
GEMINI_TIMEOUT_SECONDS=120

# --- Audio & transcription (optional) ---------------------------------------
# Local Whisper model (tiny, base, small, ...). Larger = slower but more exact.
# Downloaded once on first use to ~/.cache/whisper. Default: tiny
WHISPER_MODEL=tiny

# Maximum video length in seconds; longer videos are rejected with 400
# before downloading. Default: 600 (10 minutes)
QUIZ_MAX_VIDEO_SECONDS=600

# JavaScript runtime yt-dlp uses for YouTube (node, deno, bun). Default: node
YTDLP_JS_RUNTIME=node

# --- Database (optional) ----------------------------------------------------
# Path of the SQLite file. Default if unset: db.sqlite3 in the project folder.
# compose.yaml sets /app/data/db.sqlite3 (persistent Docker volume "db").
# DJANGO_SQLITE_PATH=/app/data/db.sqlite3

# --- Production (Docker on the VPS) -----------------------------------------
# Use these values instead of the local ones above in the VPS .env:
#   DJANGO_SECRET_KEY=<new key, generated as described above>
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=quizly.biancaliebholz.de
#   FRONTEND_ORIGINS=https://quizly.biancaliebholz.de
#   AUTH_COOKIE_SECURE=True
#   GEMINI_API_KEY=<production Gemini key>

# --- Docker resources (optional, read by compose.yaml) ----------------------
# Conservative defaults for a shared VPS; tune after checking nproc,
# free -h and docker stats on the server.
# Container CPU and RAM limits (RAM also caps swap). Defaults: 2 and 2g
# QUIZLY_CPUS=2
# QUIZLY_MEMORY_LIMIT=2g
# Gunicorn processes, threads per process, request timeout in seconds.
# Each process holds its own Whisper model in RAM. Defaults: 1, 4, 600
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=600
# CPU threads torch uses for one transcription. Default: 2
# OMP_NUM_THREADS=2
